    UsernameInput.Size = UDim2.new(0, (baseWidth - 60) * currentScale, 0, 35 * currentScale)
    UsernameInput.TextSize = math.clamp(14 * currentScale, 9, 20)
    
    JoinButton.Position = UDim2.new(0, 15 * currentScale, 0, 75 * currentScale)
    JoinButton.Size = UDim2.new(0, (baseWidth - 60) * currentScale, 0, 40 * currentScale)
