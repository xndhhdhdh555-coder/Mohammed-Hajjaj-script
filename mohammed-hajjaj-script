-- برمجيات أزرار الحجم (+ و -)
PlusButton.MouseButton1Click:Connect(function()
    if currentScale < 1.8 then -- حد أقصى للتكبير لحماية أبعاد الشاشة
        currentScale = currentScale + 0.1
        updateScale()
    end
end)

MinusButton.MouseButton1Click:Connect(function()
    if currentScale > 0.6 then -- حد أدنى للتصغير
        currentScale = currentScale - 0.1
        updateScale()
    end
end)

-- برمجة الأيقونة العائمة لإظهار وإخفاء السكربت
FloatingIcon.MouseButton1Click:Connect(function()
    BlackFrame.Visible = not BlackFrame.Visible
end)

-- برمجة زر الـ Join للبحث والانتقال
JoinButton.MouseButton1Click:Connect(function()
    local targetUsername = UsernameInput.Text
    if targetUsername == "" then 
        JoinButton.Text = "اكتب اسم اللاعب أولاً!"
        task.wait(1.5)
        JoinButton.Text = "JOIN"
        return 
    end
    
    JoinButton.Text = "جاري البحث..."
    JoinButton.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
    
    local Players = game:GetService("Players")
    local TeleportService = game:GetService("TeleportService")
    local HttpService = game:GetService("HttpService")
    
    local success, targetUserId = pcall(function()
        return Players:GetUserIdFromNameAsync(targetUsername)
    end)
    
    if not success or not targetUserId then
        JoinButton.Text = "اللاعب غير موجود!"
        JoinButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        task.wait(2)
        JoinButton.Text = "JOIN"
        JoinButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        return
    end
    
    local placeId = game.PlaceId
    local foundServer = false
    
    pcall(function()
        local url = "https://roblox.com" .. placeId .. "/servers/Public?sortOrder=Desc&limit=100"
        local serverList = HttpService:JSONDecode(game:HttpGet(url))
        
        if serverList and serverList.data then
            for _, server in ipairs(serverList.data) do
                if server.id then
                    JoinButton.Text = "جاري الانتقال..."
                    JoinButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
                    TeleportService:TeleportToPlaceInstance(placeId, server.id, Players.LocalPlayer)
                    foundServer = true
                    break
                end
            end
        end
    end)
    
    if not foundServer then
        pcall(function()
            JoinButton.Text = "محاولة دخول الماب..."
            TeleportService:Teleport(placeId, Players.LocalPlayer)
        end)
    end
end)
